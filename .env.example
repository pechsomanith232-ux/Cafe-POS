# Copy this file to `.env` and adjust. Never commit `.env`.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/cafe_pos
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/cafe_pos_test

# Generate a long random value for production, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000

# First login, created by `pnpm db:seed` (only if that email doesn't exist yet).
# Change the password after your first sign-in.
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=change-me-please
SEED_OWNER_NAME=Owner
SEED_ORG_NAME=My Café
SEED_BRANCH_CODE=B1
SEED_BRANCH_NAME=Main Branch

# Optional, for `pnpm db:seed:demo` (defaults: the owner password, PIN 1234)
DEMO_STAFF_PASSWORD=
DEMO_MANAGER_PIN=

# Product image storage: local (uploads/ folder) or s3 (Cloudflare R2 / MinIO)
STORAGE_DRIVER=local
# Folder for local images (default: uploads)
STORAGE_LOCAL_DIR=
# Region for S3 (R2 uses "auto")
S3_REGION=auto
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
